# Vendored read-only clones of the author's repos — re-clone via commands in README.md
# (kept out of git: nested .git dirs would become accidental submodule gitlinks)
vendor-acta-poc/
vendor-ivc-checkpoints/

node_modules/
.env
.env.*
!.env.example

# ZK build artifacts (regenerate: npm run compile && npm run setup -w @acta/circuits)
packages/circuits/build/
.ptau/
packages/contracts/lib/

# forge artifacts
packages/contracts/out/
packages/contracts/cache/

# machine-local deploy config (keystore names, RPC urls) — never commit
.env.deploy
